@{
    ViewData["Title"] = "Редактировать квест";
}
<h2>Редактировать квест</h2>
@if (Model != null && Model.Count > 0)
{
    <table class="table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Название</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var quest in Model)
        {
            <tr>
                <td>@quest.Id</td>
                <td>@quest.Name</td>
                <td>
                    <a href="/Admin/EditQuestItem/@quest.Id" class="btn btn-primary btn-sm">Редактировать</a>
                    <a href="/Admin/DeleteQuest/@quest.Id" class="btn btn-danger btn-sm" onclick="return confirm('Удалить этот квест?');">Удалить</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
else
{
    <div>Нет квестов для отображения.</div>
}
