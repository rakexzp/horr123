@{
    ViewData["Title"] = "Вход в админ-панель";
}
<h2>Вход в админ-панель</h2>
<form method="post">
    <label>Пароль:</label>
    <input type="password" name="password" required />
    <button type="submit">Войти</button>
    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }
</form>
