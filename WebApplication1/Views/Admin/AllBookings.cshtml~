@model List<WebApplication1.Models.AdminBookingViewModel>
@{
    ViewBag.Title = "Забронированные квесты";
}
<h2>Забронированные квесты</h2>
<table class="table table-bordered">
    <thead>
        <tr>
            <th>Квест</th>
            <th>Дата</th>
            <th>Время</th>
            <th>Имя</th>
            <th>Телефон</th>
            <th>Email</th>
            <th>Статус оплаты</th>
            <th>UserId</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.QuestName</td>
                <td>@item.Date</td>
                <td>@item.Time</td>
                <td>@item.Name</td>
                <td>@item.Phone</td>
                <td>@item.Email</td>
                <td>@item.PaymentStatus</td>
                <td>@item.UserId</td>
            </tr>
        }
    </tbody>
</table>
