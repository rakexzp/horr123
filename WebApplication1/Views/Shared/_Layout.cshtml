<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - Готэм: Тени Греха</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/WebApplication1.styles.css" asp-append-version="true"/>
</head>
<body class="d-flex flex-column">
<header class="fixed-top">
    <nav class="navbar navbar-expand-lg  navbar-dark bg-transparent fixed-top">
        <ul class="navbar-nav">
            <li class="nav-item">
                <a class="navbar-brand">Готэм: Тени Греха</a>
              
            <li class="nav-item active">
                <a class="nav-link" data-target="#about" href="#about">Об игре</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="#">Забронировать</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="#">Где находиться</a>
            </li>
        </ul>
    </nav>
</header>
<div class="container">
    <main>
        @RenderBody()
    </main>
</div>

<footer class="curtain-footer">
    <div class="container">
        <div class="row">
            <div class="col-md-4">
                <h5>О нас</h5>
                <ul>
                    <li><a href="#">Команда</a></li>
                    <li><a href="#">Контакты</a></li>
                </ul>
            </div>
            <div class="col-md-4">
                <h5>Ссылки</h5>
                <ul>
                    <li><a href="#">Главная</a></li>
                    <li><a href="#about">Об игре</a></li>
                </ul>
            </div>
            <div class="col-md-4">
                <h5>Социальные сети</h5>
                <ul>
                    <li><a href="#">Tiktok</a></li>
                    <li><a href="https://vk.com/club228107434">VK</a></li>
                </ul>
            </div>
        </div>
    </div>
</footer>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>