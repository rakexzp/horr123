@using WebApplication1.Models
@model BookingViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Бронирование: @Model.Quest?.Name</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <style>
        body {
            background: #232323;
            background-image: url('sitydark.jpg');
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
        }
        @@media (max-width: 768px) {
            body {
                background-image: url('sitydark_mobile.png');
                background-size: 100vw 100vh;
                background-repeat: no-repeat;
                background-position: center;
                min-height: 100vh;
                height: 100vh;
                width: 100vw;
                overflow-x: hidden;
            }
            .container, .container-fluid, .card.bg-dark {
                background: transparent !important;
                box-shadow: none !important;
            }
        }
        .slot { margin: 2px; padding: 8px 12px; border-radius: 5px; border: 1px solid #888; cursor: pointer; display:inline-block;}
        .slot.booked { background: #ffcccc; color: #a00; cursor: not-allowed; }
        .slot.selected { background: #cce5ff; color: #0056b3; }
        #slots .slot {
            display: inline-block;
            margin: 0.25em;
            padding: 0.5em 1em;
            border-radius: 8px;
            background: #222;
            color: #f8f9fa;
            cursor: pointer;
            border: 1px solid #444;
            margin-bottom: 0.5em;
            transition: background 0.25s, color 0.25s, transform 0.18s, box-shadow 0.18s;
        }
        #slots .slot:hover:not(.booked) {
            background: #20c997;
            color: #232323;
            transform: scale(1.08);
            box-shadow: 0 0 10px #20c99788;
        }
        #slots .slot.selected {
            background: #ffc107;
            color: #232323;
            transform: scale(1.13);
            box-shadow: 0 0 16px #ffc10777;
        }
        #slots .slot.booked {
            background: #444;
            color: #bbb;
            cursor: not-allowed;
            text-decoration: line-through;
            transform: none;
            box-shadow: none;
        }
        .btn-success, .btn-primary {
            transition: box-shadow 0.25s, background 0.25s, color 0.25s;
            box-shadow: 0 2px 8px rgba(25,135,84,0.12);
        }
        .btn-success:hover, .btn-success:focus {
            background: #28d47c;
            color: #232323;
            box-shadow: 0 0 16px 2px #28d47c88;
        }
        .btn-primary:hover, .btn-primary:focus {
            background: #20c997;
            color: #232323;
            box-shadow: 0 0 16px 2px #20c99788;
        }
        .card.bg-dark {
            background: #333 !important;
        }
    </style>
</head>
<body>
    <div class="container mt-5">
        <div class="card bg-dark text-light shadow-lg mx-auto" style="max-width: 600px; border-radius: 1.5rem;">
            <div class="card-body">
                <h2 class="card-title text-center mb-4">Бронирование: @Model.Quest?.Name</h2>
                @if (Model.Success)
                {
                    <div class="alert alert-success text-center">Бронирование успешно! Мы свяжемся с вами.</div>
                    <div class="text-center">
                        <a href="/" class="btn btn-primary mt-3">Вернуться на главную</a>
                    </div>
                }
                else
                {
                    <form method="post" class="mt-4">
                        <!-- ValidationSummary удалён по просьбе пользователя -->
                        <input type="hidden" name="questId" value="@Model.Quest?.Id" />
                        <div class="mb-3">
                            <label class="form-label">Дата:</label>
                            <input id="datePicker" name="selectedDate" value="@Model.SelectedDate" class="form-control bg-secondary text-light" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Время:</label><br />
                            <div id="slots">
                                @foreach (var slot in Model.AllSlots)
                                {
                                    var isBooked = Model.BookedSlots.Contains(slot);
                                    <span class="slot @(isBooked ? "booked" : "")" data-time="@slot">@slot</span>
                                }
                                <input type="hidden" name="selectedTime" id="selectedTime" />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Имя:</label>
                            <input type="text" name="name" required value="@Model.Name" class="form-control bg-secondary text-light" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Телефон:</label>
                            <input type="text" name="phone" required value="@Model.Phone" class="form-control bg-secondary text-light" />
                            @Html.ValidationMessage("phone", new { @class = "text-danger" })
                        </div>
                        <div class="mb-3">
                            <label class="form-label">E-mail:</label>
                            <input type="email" name="email" required value="@Model.Email" class="form-control bg-secondary text-light" />
                            @Html.ValidationMessage("email", new { @class = "text-danger" })
                        </div>
                        <button type="submit" class="btn btn-success w-100">Забронировать</button>
                    </form>
                }
            </div>
        </div>
    </div>
    <!-- Кнопка "Наверх" -->
    <button onclick="window.scrollTo({top: 0, behavior: 'smooth'});" id="btnUp" style="position:fixed;bottom:32px;right:20px;z-index:1000;display:none; background: #232d2f; color: #fff; border: none; width: 48px; height: 48px; border-radius: 50%; box-shadow: 0 2px 8px rgba(0,0,0,0.2); transition: background 0.2s;" class="btn-up-custom">
        <svg xmlns='http://www.w3.org/2000/svg' width='28' height='28' fill='white' viewBox='0 0 16 16' style="display:block; margin:auto;">
            <path d='M8 3.293l4.646 4.647-.708.707L8 4.707l-3.938 3.94-.708-.707L8 3.293z'/>
        </svg>
    </button>
    <script>
        flatpickr("#datePicker", {
            defaultDate: "@Model.SelectedDate",
            dateFormat: "Y-m-d",
            minDate: "today"
        });
        // Слот выбора времени
        document.querySelectorAll('.slot').forEach(function(el) {
            el.addEventListener('click', function() {
                if (el.classList.contains('booked')) return;
                document.querySelectorAll('.slot').forEach(e => e.classList.remove('selected'));
                el.classList.add('selected');
                document.getElementById('selectedTime').value = el.getAttribute('data-time');
            });
        });
        window.addEventListener('scroll', function() {
            document.getElementById('btnUp').style.display = (window.scrollY > 300) ? 'block' : 'none'; 
        });
        document.getElementById('btnUp').addEventListener('touchstart', function(e) {
            this.style.background = '#444';
        });
        document.getElementById('btnUp').addEventListener('touchend', function(e) {
            this.style.background = '#232d2f';
        });
    </script>
</body>
</html>